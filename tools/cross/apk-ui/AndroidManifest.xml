<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.velnoxy.velnosubui"
    android:versionCode="16"
    android:versionName="0.1.1-ui-alpha12">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="28"/>
    <!-- P5.5: kendi dosyaları (.ass/.srt/.mkv…) — READ_EXTERNAL_STORAGE
         (smoke.sh pm grant ile verilir; targetSdk 28 = legacy storage) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <!-- UI alpha: yalnızca filesDir (asset kopyası); depolama izni kuyrukta (SAF fazı) -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:debuggable="true">
        <activity android:name="android.app.NativeActivity"
                  android:label="@string/app_name"
                  android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
                  android:exported="true"
                  android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="android.app.lib_name" android:value="velnosub_ui"/>
        </activity>
    </application>
</manifest>
